                    [ -z "$query" ] && { [ "$hub_mode" = 1 ] && continue || exit 0; }
                fi
            fi

            # for checking new releases by specifying anime name
            [ "$source" = "nextep" ] && time_until_next_ep "$query"

            if [ -z "$result" ]; then
                user_query="$(printf "%s" "$query" | tr '+' ' ')"
