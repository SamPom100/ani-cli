#!/bin/sh

version_number="5.3.0"

# UI

# shellcheck disable=SC2086
# $1 = prompt, $2 = multi select flag (for fzf/rofi), $3 = extra flags by user
menu() {
    case "$menu_program" in
        fzf) fzf --reverse --cycle --prompt "$1" --delimiter '\t' --with-nth "${menu_with_nth:-1,4,3}" --tabstop 4 ${menu_preview:+--preview "$menu_preview" --preview-window "$preview_window"} ${menu_reload:+--disabled --print-query --bind "change:reload($menu_reload)"} $2 $3 ;;
        rofi) rofi -sort -dmenu -i -p "$1" $2 $3 ;;
        dmenu) dmenu -l 20 -p "$1" $3 ;;
        *) "$menu_program" $3 "$1" ;;
    esac
}

# provide menu. input format is either (ep_list) or (number \t anime_id \t anime_name [\t details])
nth() {
    _stdin=$(cat -)
    [ -z "$_stdin" ] && return 1
    _line_count="$(printf "%s\n" "$_stdin" | wc -l | tr -d "[:space:]")"
    [ "$_line_count" -eq 1 ] && [ "${3:-}" != "force" ] && printf "%s" "$_stdin" | cut -f 2- && return 0
    _prompt="$1"
    [ $# -ge 2 ] && _multi_flag="$2"
    if [ "$menu_program" = "fzf" ]; then
        # fzf gets the raw lines, it hides the id and reorders the columns itself (see menu)
        _line=$(printf "%s" "$_stdin" | menu "$_prompt" "$_multi_flag" "$menu_extra_flags" | cut -f 1)
    else
        # other menus get plain text: number, details (if any), then the name. literal tabs, BSD sed has no \t in brackets
        _line=$(printf "%s" "$_stdin" | sed -E 's|^([^	]*)	[^	]*	([^	]*)	([^	]*)$|\1 \3 \2|' | cut -f 1,3 | tr '\t' ' ' | menu "$_prompt" "$_multi_flag" "$menu_extra_flags" | cut -d " " -f 1)
    fi
    _line_start=$(printf "%s" "$_line" | head -n 1)
    _line_end=$(printf "%s" "$_line" | tail -n 1)
    [ -n "$_line" ] || return 1
    if [ "$_line_start" = "$_line_end" ]; then
        printf "%s" "$_stdin" | grep -E '^'"${_line}"'($|[[:space:]])' | cut -f 2- || return 1
    else
        printf "%s" "$_stdin" | sed -n '/^'"${_line_start}"'$/,/^'"${_line_end}$"'/p' || return 1
    fi
}

# fzf reloads a list while typing since 0.25
fzf_reloads() {
    _fzf_version=$(fzf --version | cut -d ' ' -f 1)
    case "$_fzf_version" in
        0.[0-9].* | 0.1[0-9].* | 0.2[0-4].*) return 1 ;;
        *) return 0 ;;
    esac
}

# search while typing: fzf asks the site again after every change and shows what it found, Enter picks a result.
# sets query (what was typed) and result (id \t title of the pick, empty when nothing was picked)
live_search() {
    menu_reload="sleep 0.3; sh '$script_path' --search {q}"
    _picked=$(: | menu "Search anime: " "" "$menu_extra_flags")
    _fzf_status=$?
    unset menu_reload
    [ "$_fzf_status" -ne 0 ] && return "$_fzf_status"
    query=$(printf "%s\n" "$_picked" | head -n 1)
    result=$(printf "%s\n" "$_picked" | sed -n '2p' | cut -f 2,3)
}

