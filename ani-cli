                    fav_label="⭐ In Favorites (Remove)"
                fi
                selection=$(printf "%s\n%s" "$fav_label" "$ep_list" | menu "Select episode of $anime_title: " "$menu_multi_flag" "$menu_extra_flags")
                [ -z "$selection" ] && break
                case "$selection" in
                    *"Add to Favorites"*)
                        "$fav_bin" add "$anime_title"
                        ;;
                    *"In Favorites (Remove)"*)
                        "$fav_bin" remove "$anime_title"
                        ;;
                    *)
                        _selected_ep="$selection"
                        break
                        ;;
                esac
            done
            [ -z "$_selected_ep" ] && continue
            ep_no="$_selected_ep"
            ;;
        change_quality)
            new_quality="$(printf "%s" "$links" | menu "Select Quality: " "" "$menu_extra_flags" | cut -d ">" -f 1)"
            [ -z "$new_quality" ] && die "No quality selected"
            select_quality "$new_quality"
            ;;
        favorite)
            if grep -qi "^${anime_title}$" "${hist_dir}/favorites.txt" 2>/dev/null; then
                "$fav_bin" remove "$anime_title"
            else
                "$fav_bin" add "$anime_title"
            fi
            continue
            ;;
        *)
            cleanup
            exit 0
            ;;
    esac
    [ -z "$ep_no" ] && die "Out of range"
    play
done

