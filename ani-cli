                        query=$("$sched_bin" "$sched_choice" --select)
                        ;;
                esac
                [ -z "$query" ] && continue
                ;;
            Continue)
                source=history
                ;;
            Search)
                if [ "$menu_program" = "fzf" ] && fzf_reloads; then
